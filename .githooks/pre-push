#!/bin/sh
# Refuses to publish demo/debug content. See AGENTS.md.
# Install: cp .githooks/pre-push "$(git rev-parse --git-common-dir)/hooks/pre-push"

DEMO_PATHS="
_drafts/everything-a-post-can-do.md
_drafts/sharing-ktor-client-kmp.md
assets/images/posts/everything-a-post-can-do
assets/images/posts/sharing-ktor-client-kmp
"
ZERO=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_ref" = "refs/heads/debug" ] || [ "$remote_ref" = "refs/heads/debug" ]; then
        echo "pre-push: refusing to push the debug branch ($local_ref -> $remote_ref). See AGENTS.md." >&2
        status=1
        continue
    fi
    [ "$local_sha" = "$ZERO" ] && continue # deleting a remote branch
    for path in $DEMO_PATHS; do
        if [ -n "$(git ls-tree -r --name-only "$local_sha" -- "$path")" ]; then
            echo "pre-push: $remote_ref would publish demo content ($path). See AGENTS.md." >&2
            status=1
        fi
    done
done

exit $status
